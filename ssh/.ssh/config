# ~/.ssh/config - Configuración de SSH

# Configuración global por defecto
Host *
    # Usar compresión para conexiones lentas
    Compression yes
    
    # Mantener conexiones activas
    ServerAliveInterval 60
    ServerAliveCountMax 3
    
    # Usar autenticación por clave por defecto
    PreferredAuthentications publickey,keyboard-interactive,password
    
    # Habilitar forwarding de agente SSH
    ForwardAgent yes
    
    # Control de conexiones persistentes
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h-%p
    ControlPersist 600
    
    # Configuraciones de seguridad
    HashKnownHosts yes
    VisualHostKey yes
    
    # Timeouts
    ConnectTimeout 30

# Ejemplo de configuración para GitHub
Host github.com
    HostName github.com
    User git
    Port 22
    PreferredAuthentications publickey
    IdentitiesOnly yes
    # Descomenta y ajusta la siguiente línea con tu clave SSH
    IdentityFile ~/.ssh/kobogithub

# Ejemplo de configuración para un servidor personal
# Host miservidor
#     HostName ejemplo.com
#     User tu-usuario
#     Port 22
#     IdentityFile ~/.ssh/id_rsa
#     ForwardX11 yes

# Configuración para servidores de desarrollo local
Host localhost
    HostName 127.0.0.1
    User $(whoami)
    Port 22
    PreferredAuthentications publickey,password

# Configuración para conexiones en LAN (ajustar según tu red)
Host 192.168.*.*
    User $(whoami)
    PreferredAuthentications publickey,password
    ConnectTimeout 10

