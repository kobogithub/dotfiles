# MCP
# Context 7
# Solo intentamos leer el secret si `pass` está instalado y el password-store
# existe. Evita el ruido de gpg/pass en máquinas donde ese stack no está
# inicializado (la variable queda simplemente sin definir).
if command -v pass >/dev/null 2>&1 && [ -d "${PASSWORD_STORE_DIR:-$HOME/.password-store}" ]; then
    export CONTEXT7_API_KEY="$(pass show mcps/context7 2>/dev/null)"
fi
