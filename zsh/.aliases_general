# claude-speak (TTS de las respuestas de Claude Code, hook Stop)
alias claude-mute='touch ~/.claude/claude-speak.mute; pkill -x say 2>/dev/null; echo "claude-speak: muteado"'
alias claude-unmute='rm -f ~/.claude/claude-speak.mute; echo "claude-speak: activo"'
alias claude-mute-status='[ -f ~/.claude/claude-speak.mute ] && echo "claude-speak: muteado" || echo "claude-speak: activo"'
alias cmu='claude-mute'     # atajo: mutear claude-speak
alias cun='claude-unmute'   # atajo: desmutear claude-speak

# claude-sessions: buscador global de sesiones de Claude Code (fzf) de todos los repos
alias ccs='claude-sessions'
# claude-usage: analisis de tokens/costos de Claude Code (--html para dashboard)
alias ccu='claude-usage'

# CLI modernas (mejoras de experiencia)
command -v bat >/dev/null 2>&1 && alias cat='bat --paging=never'  # cat con syntax highlight
alias lzg='lazygit'      # TUI de git (git lg sigue siendo el log graph)
alias lzd='lazydocker'   # TUI de docker

# yz - yazi (gestor de archivos en terminal, reemplaza a Finder). El wrapper
# existe para que al salir con `q` el shell quede en el directorio donde
# estabas navegando; `Q` sale sin cambiar de directorio.
# Se llama `yz` y no `y` porque `y` ya es alias de yarn (.nodejs_config).
yz() {
    command -v yazi >/dev/null 2>&1 || { echo "❌ yazi no está instalado (brew install yazi)"; return 1; }
    local tmp cwd
    tmp="$(mktemp -t yazi-cwd.XXXXXX)"
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
        builtin cd -- "$cwd" || return
    fi
    rm -f -- "$tmp"
}

# als - buscador interactivo (fzf) de TODOS los aliases activos (incluye .zshrc
# y los sourceados). Uso: als [patrón]. Enter copia el alias al portapapeles.
als() {
    command -v fzf >/dev/null 2>&1 || { alias | grep -i "${1:-}"; return; }
    local sel
    sel=$(alias | sort | fzf --query="${1:-}" --prompt='alias > ' \
        --height=60% --reverse --no-sort --header='Enter: copiar  ·  Ctrl-C: salir') || return
    [ -n "$sel" ] || return
    print -r -- "$sel"
    if command -v pbcopy >/dev/null 2>&1; then
        print -rn -- "$sel" | pbcopy && print -- "  (copiado al portapapeles)"
    elif command -v xclip >/dev/null 2>&1; then
        print -rn -- "$sel" | xclip -selection clipboard && print -- "  (copiado al portapapeles)"
    fi
}

# Git clone helpers — usan los hosts SSH definidos en ~/.ssh/config
# Uso: clone-personal [owner/]repo   →  ~/Github/personal/<repo>
#      clone-work     [owner/]repo   →  ~/Github/taligent/<repo>
clone-personal() {
    local arg="${1:?Uso: clone-personal [owner/]repo}"
    local slug repo dest
    [[ "$arg" == */* ]] && slug="$arg" || slug="kobogithub/$arg"
    repo="${slug##*/}"; repo="${repo%.git}"
    dest="$HOME/Github/personal/$repo"
    git clone "git@me:${slug%.git}.git" "$dest" && cd "$dest"
}

clone-work() {
    local arg="${1:?Uso: clone-work [owner/]repo}"
    local slug repo dest
    [[ "$arg" == */* ]] && slug="$arg" || slug="kevintali/$arg"
    repo="${slug##*/}"; repo="${repo%.git}"
    dest="$HOME/Github/taligent/$repo"
    git clone "git@work:${slug%.git}.git" "$dest" && cd "$dest"
}
