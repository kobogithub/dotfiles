# ~/.dotfiles/zsh/.aliases_general - Aliases generales y de gestión

# Aliases para editar archivos de configuración de dotfiles
alias edit-zsh='${EDITOR:-nvim} ~/.dotfiles/zsh/.zshrc'
alias edit-aliases-k8s='${EDITOR:-nvim} ~/.dotfiles/kubectl/.aliases_k8s'
alias edit-aliases-docker='${EDITOR:-nvim} ~/.dotfiles/docker/.docker_aliases'
alias edit-aliases-general='${EDITOR:-nvim} ~/.dotfiles/zsh/.aliases_general'

# Aliases para recargar configuración
alias reload-zsh='source ~/.zshrc'
alias reload-aliases='source ~/.dotfiles/zsh/.zshrc'

# Shortcuts para navegar en dotfiles
alias cdot='cd ~/.dotfiles'
alias lsdot='ls -la ~/.dotfiles'

# Listar todos los archivos de aliases cargados
alias list-aliases='echo "Loaded alias files:"; \
    [ -f "$HOME/.dotfiles/docker/.docker_aliases" ] && echo "✓ Docker aliases"; \
    [ -f "$HOME/.dotfiles/kubectl/.aliases_k8s" ] && echo "✓ Kubernetes aliases"; \
    [ -f "$HOME/.dotfiles/zsh/.aliases_general" ] && echo "✓ General aliases"'

# Gestor de aliases
alias alm='alias-manager'
alias alias-add='alias-manager add'
alias alias-rm='alias-manager remove'
alias alias-list='alias-manager list'
alias alias-search='alias-manager search'

# Atuin dotfiles (aliases persistentes con Atuin)
alias atuin-alias-set='atuin dotfiles alias set'
alias atuin-alias-list='atuin dotfiles alias list'
alias atuin-alias-rm='atuin dotfiles alias delete'
alias atuin-var-set='atuin dotfiles var set'
alias atuin-var-list='atuin dotfiles var list'

# Zoxide (navegación inteligente)
alias cdi='cd'  # cd interactivo con fzf (si --cmd cd está configurado, cdi = zi)
alias zq='zoxide query'
alias zql='zoxide query -l'
alias zqs='zoxide query -l -s'
alias zr='zoxide remove'

# Opencode
export OPENCODE_SERVER_USERNAME="kobo"
alias ocsrv='OPENCODE_SERVER_PASSWORD=$OPENCODE_SERVER_PASSWORD opencode serve'

# Homebrew
export HOMEBREW_NO_ENV_HINTS=1

# Herdr
alias hr='herdr'

# claude-speak (TTS de las respuestas de Claude Code, hook Stop)
alias claude-mute='touch ~/.claude/claude-speak.mute; pkill -x say 2>/dev/null; echo "claude-speak: muteado"'
alias claude-unmute='rm -f ~/.claude/claude-speak.mute; echo "claude-speak: activo"'
alias claude-mute-status='[ -f ~/.claude/claude-speak.mute ] && echo "claude-speak: muteado" || echo "claude-speak: activo"'
alias cmu='claude-mute'     # atajo: mutear claude-speak
alias cun='claude-unmute'   # atajo: desmutear claude-speak

# claude-sessions: buscador global de sesiones de Claude Code (fzf) de todos los repos
alias ccs='claude-sessions'
# claude-usage: analisis de tokens/costos de Claude Code (--html para dashboard)
alias ccu='claude-usage'

# Git clone helpers — usan los hosts SSH definidos en ~/.ssh/config
# Uso: clone-personal [owner/]repo   →  ~/Github/personal/<repo>
#      clone-work     [owner/]repo   →  ~/Github/taligent/<repo>
clone-personal() {
    local arg="${1:?Uso: clone-personal [owner/]repo}"
    local slug repo dest
    [[ "$arg" == */* ]] && slug="$arg" || slug="kobogithub/$arg"
    repo="${slug##*/}"; repo="${repo%.git}"
    dest="$HOME/Github/personal/$repo"
    git clone "git@me:${slug%.git}.git" "$dest" && cd "$dest"
}

clone-work() {
    local arg="${1:?Uso: clone-work [owner/]repo}"
    local slug repo dest
    [[ "$arg" == */* ]] && slug="$arg" || slug="kevintali/$arg"
    repo="${slug##*/}"; repo="${repo%.git}"
    dest="$HOME/Github/taligent/$repo"
    git clone "git@work:${slug%.git}.git" "$dest" && cd "$dest"
}
