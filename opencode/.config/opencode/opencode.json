{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "mode": "primary",
      "description": "Full-stack development with all tools enabled",
      "temperature": 0.3
    },
    "plan": {
      "mode": "primary",
      "description": "Analysis and planning without making changes",
      "temperature": 0.1,
      "permission": {
        "edit": "ask",
        "write": "ask",
        "bash": {
          "*": "ask",
          "git status": "allow",
          "git log*": "allow",
          "git diff*": "allow"
        }
      }
    },
    "astro-dev": {
      "mode": "subagent",
      "description": "Astro framework expert for building modern web applications",
      "model": "github-copilot/claude-sonnet-4.5",
      "temperature": 0.2,
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "permission": {
        "bash": {
          "*": "ask",
          "npm*": "allow",
          "pnpm*": "allow",
          "node*": "allow"
        }
      }
    },
    "docker-expert": {
      "mode": "subagent",
      "description": "Docker containerization expert for development and production",
      "model": "github-copilot/claude-sonnet-4.5",
      "temperature": 0.2,
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "permission": {
        "bash": {
          "*": "ask",
          "docker*": "allow",
          "docker-compose*": "allow"
        }
      }
    },
    "docs-writer": {
      "mode": "subagent",
      "description": "Technical documentation expert for code, APIs, and architecture",
      "model": "github-copilot/claude-sonnet-4.5",
      "temperature": 0.2,
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "fastapi-dev": {
      "mode": "subagent",
      "description": "FastAPI development expert for building robust REST APIs",
      "model": "github-copilot/claude-sonnet-4.5",
      "temperature": 0.2,
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      },
      "permission": {
        "bash": {
          "*": "ask",
          "pytest*": "allow",
          "uvicorn*": "allow",
          "pip*": "allow"
        }
      }
    },
    "postgres-admin": {
      "mode": "subagent",
      "description": "PostgreSQL database expert for optimization and administration",
      "model": "github-copilot/claude-sonnet-4.5",
      "temperature": 0.2,
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "qa-engineer": {
      "mode": "subagent",
      "description": "QA and testing expert for comprehensive test strategies and implementation",
      "model": "github-copilot/claude-sonnet-4.5",
      "temperature": 0.2,
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    },
    "supabase-dev": {
      "mode": "subagent",
      "description": "Supabase expert for backend-as-a-service development",
      "model": "github-copilot/claude-sonnet-4.5",
      "temperature": 0.2,
      "tools": {
        "write": true,
        "edit": true,
        "bash": true
      }
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  }
}
