{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "build": {
      "mode": "primary",
      "description": "Full-stack development with all tools enabled",
      "temperature": 0.3,
      "enabled": false
    },
    "plan": {
      "mode": "primary",
      "description": "Analysis and planning without making changes",
      "temperature": 0.1,
      "permission": {
        "edit": "ask",
        "write": "ask",
        "bash": {
          "*": "ask",
          "git status": "allow",
          "git log*": "allow",
          "git diff*": "allow"
        }
      }
    }
  },
  "permission": {
    "skill": {
      "*": "allow"
    }
  }
}
