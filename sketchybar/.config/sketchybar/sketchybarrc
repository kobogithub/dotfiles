#!/usr/bin/env bash
# Configuración de sketchybar — tema Frostmourne, pensada para AeroSpace.
#
# Barra flotante: no toca los bordes de la pantalla. El hueco que hay que
# reservar en gaps.outer.top de aerospace/.aerospace.toml es
# BAR_MARGIN + BAR_HEIGHT + BAR_MARGIN (8 + 32 + 8 = 48). Si no coincide,
# las ventanas quedan por debajo de la barra y la tapan.

export CONFIG_DIR="$HOME/.config/sketchybar"
export PLUGIN_DIR="$CONFIG_DIR/plugins"
export FONT="Iosevka Nerd Font"
export BAR_HEIGHT=32
export BAR_MARGIN=8
# Ciudad para el clima. Vacío = la deduce wttr.in de la IP pública.
export WEATHER_LOCATION=""

source "$CONFIG_DIR/colors.sh"

##### Barra #####
sketchybar --bar \
    height="$BAR_HEIGHT" \
    position=top \
    sticky=on \
    topmost=off \
    shadow=on \
    margin="$BAR_MARGIN" \
    y_offset="$BAR_MARGIN" \
    corner_radius=10 \
    border_width=2 \
    border_color="$BAR_BORDER" \
    blur_radius=20 \
    padding_left=6 \
    padding_right=6 \
    color="$BAR_BG"

##### Valores por defecto de todo item #####
sketchybar --default \
    updates=when_shown \
    icon.font="$FONT:Bold:14.0" \
    icon.color="$FG" \
    icon.padding_left=8 \
    icon.padding_right=4 \
    label.font="$FONT:Semibold:13.0" \
    label.color="$FG" \
    label.padding_left=4 \
    label.padding_right=8 \
    background.color="$ITEM_BG" \
    background.corner_radius=6 \
    background.height=22 \
    background.drawing=off

##### Items #####
source "$CONFIG_DIR/items/spaces.sh"
source "$CONFIG_DIR/items/front_app.sh"
source "$CONFIG_DIR/items/clock.sh"
source "$CONFIG_DIR/items/battery.sh"
source "$CONFIG_DIR/items/volume.sh"
source "$CONFIG_DIR/items/network.sh"
source "$CONFIG_DIR/items/weather.sh"
source "$CONFIG_DIR/items/cpu.sh"
source "$CONFIG_DIR/items/memory.sh"

##### Aplicar #####
sketchybar --update
