#!/bin/bash

# herdr-nav - Navegador difuso de Herdr.app (fzf)
# Uso: herdr-nav [-h] [PATRON]
#
# Una sola lista para saltar a cualquier lado, al estilo de herdr-navigator:
#   agente      terminales con un agente (claude, codex...), con su estado;
#               la preview muestra su pantalla.
#   tab         cada pestaña de cada space.
#   dir         directorios de zoxide: abre un space ahi (o una pestaña, si
#               ya hay un space en esa carpeta).
# Las sesiones viejas no estan aca: para eso son claude-sessions y memex.
#
#   PATRON   consulta inicial opcional para filtrar en fzf.
#
# En la app lo abre cmd+shift+f (keys.json) en una pestaña que se cierra sola.
# Requiere: python3, fzf, herdr-app, hc; zoxide es opcional.

set -euo pipefail

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    sed -n '3,17p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi

# Preview (invocada por fzf con la linea elegida).
if [ "${1:-}" = "--preview" ]; then
    kind="$(printf '%s' "$2" | cut -f1)"
    ref="$(printf '%s' "$2" | cut -f2)"
    case "$kind" in
        agente) hc read "$ref" --lines 60 2>/dev/null | tail -n 60 ;;
        dir)    ls -la "$ref" 2>/dev/null ;;
        tab)    echo "Pestaña $ref" ;;
    esac
    exit 0
fi

for bin in herdr-app hc fzf python3; do
    command -v "$bin" >/dev/null 2>&1 || { echo "❌ falta $bin" >&2; exit 1; }
done

# Cada linea: "<tipo>TAB<ref>TAB<texto visible>". fzf muestra solo el texto.
list_entries() {
    python3 - <<'PYEOF'
import json, subprocess

def run(*args):
    out = subprocess.run(args, capture_output=True, text=True, check=True).stdout
    return json.loads(out)

ICON = {"blocked": "×", "working": "◐", "done": "✓", "idle": "○"}
ORDER = {"blocked": 0, "done": 1, "working": 2, "idle": 3}

spaces = run("herdr-app", "ls")["spaces"]
agents, tabs = [], []
for space in spaces:
    for tab in space["tabs"]:
        where = f"{space['name']} / {tab['name']}"
        tabs.append(("tab", tab["id"], f"  tab     {where}"))
        for term in tab["terminals"]:
            status = term.get("status")
            if not status:
                continue  # una shell pelada no es un agente
            app = term.get("app") or "?"
            agents.append((ORDER.get(status, 9), ("agente", term["terminal"],
                f"{ICON.get(status, '?')} agente  {where}  ·  {app} ({status})")))

for _, entry in sorted(agents, key=lambda a: a[0]):
    print("\t".join(entry))
for entry in tabs:
    print("\t".join(entry))
PYEOF

    if command -v zoxide >/dev/null 2>&1; then
        zoxide query -l 2>/dev/null | while IFS= read -r dir; do
            printf 'dir\t%s\t  dir     %s\n' "$dir" "${dir/#$HOME/~}"
        done
    fi
}

selected="$(
    list_entries | fzf --delimiter=$'\t' --with-nth=3 \
        --prompt='herdr> ' --query="${1:-}" \
        --header='Enter: ir · Esc: salir' \
        --preview="$0 --preview {}" --preview-window='right,55%,wrap'
)" || exit 0
[ -n "$selected" ] || exit 0

kind="$(printf '%s' "$selected" | cut -f1)"
ref="$(printf '%s' "$selected" | cut -f2)"

case "$kind" in
    agente) herdr-app "do" agent.focus --terminal "$ref" >/dev/null ;;
    tab)    herdr-app "do" tab.select --id "$ref" >/dev/null ;;
    dir)    "$(command -v herdr-open || echo "$HOME/.local/bin/herdr-open")" "$ref" ;;
esac
