# Ghostty config - Paleta Lich King / Frostmourne

# Fuente — Iosevka: estrecha y afilada (carámbano/runa) para el tema Frostmourne
font-family = "Iosevka Nerd Font Mono"
font-size = 15
font-thickening = true

# Tamaño y geometría
window-width = 220
window-height = 50
window-padding-x = 8
window-padding-y = 8

# Decoraciones de ventana
macos-titlebar-style = hidden

# Cursor
cursor-style = block
cursor-style-blink = false

# Scrollback
scrollback-limit = 10000

# Shell
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ===== PALETA LICH KING / FROSTMOURNE =====
# Icecrown: negro-azul glacial + acentos de runa gélida
background = #070B14
foreground = #D6E4F0

# Negros (normal + bright) → hielo profundo / acero de la Plaga
palette = 0=#0B0F1A
palette = 8=#3A4A63

# Rojos → rojo necrótico (heridas de la Escarcha)
palette = 1=#C75450
palette = 9=#E06C75

# Verdes → verde de almas (glow espectral)
palette = 2=#5FD9B0
palette = 10=#7FE9C6

# Amarillos → escarcha pálida (evita el amarillo cálido)
palette = 3=#A9D4E8
palette = 11=#C6E8F5

# Azules → azul glaciar
palette = 4=#4FA8D8
palette = 12=#6FC5F0

# Magentas → púrpura de la Plaga (Scourge)
palette = 5=#9D7CD8
palette = 13=#B79FE6

# Cianes → cian de Frostmourne (el acento estrella)
palette = 6=#3FE0E0
palette = 14=#6FF0F0

# Blancos → blanco hielo
palette = 7=#B8C9DD
palette = 15=#E8F1FA

# Cursor y selección → runa de Frostmourne
cursor-color = #3FE0E0
selection-background = #1A2740
selection-foreground = #E8F1FA

# Transparencia — vidrio esmerilado (hielo de Icecrown)
background-opacity = 0.88
background-blur = true

# Comportamiento
confirm-close-surface = false
quit-after-last-window-closed = true
copy-on-select = clipboard
mouse-hide-while-typing = true

# macOS
macos-option-as-alt = true
