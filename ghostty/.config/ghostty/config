# Ghostty config - Paleta Taligent

# Fuente
font-family = "JetBrainsMono Nerd Font"
font-size = 14
font-thickening = true

# Tamaño y geometría
window-width = 220
window-height = 50
window-padding-x = 8
window-padding-y = 8

# Decoraciones de ventana
macos-titlebar-style = hidden

# Cursor
cursor-style = block
cursor-style-blink = false

# Scrollback
scrollback-limit = 10000

# Shell
shell-integration = zsh
shell-integration-features = cursor,sudo,title

# ===== PALETA TALIGENT =====
background = #0A0809
foreground = #f8f5f0

# Negros (normal + bright)
palette = 0=#141215
palette = 8=#4A4244

# Rojos → naranja Taligent
palette = 1=#EB7522
palette = 9=#f4a91c

# Verdes
palette = 2=#56B36A
palette = 10=#56B36A

# Amarillos / ámbar
palette = 3=#f4a91c
palette = 11=#f7b728

# Azules → gris cálido
palette = 4=#A8A29A
palette = 12=#B8B2A8

# Magentas → naranja (coherente con Taligent)
palette = 5=#EB7522
palette = 13=#f4a91c

# Cianes → verde suave
palette = 6=#56B36A
palette = 14=#56B36A

# Blancos
palette = 7=#D8D2C8
palette = 15=#f8f5f0

# Cursor y selección
cursor-color = #EB7522
selection-background = #2E2829
selection-foreground = #f8f5f0

# Comportamiento
confirm-close-surface = false
quit-after-last-window-closed = true
copy-on-select = clipboard
mouse-hide-while-typing = true

# macOS
macos-option-as-alt = true
