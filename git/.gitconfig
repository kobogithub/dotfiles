[user]
	name = Kevin Barroso

[init]
	defaultBranch = dev

[core]
	editor = nvim
	autocrlf = false
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true       # usar n/N para saltar entre archivos en el diff
	line-numbers = true

[merge]
	conflictstyle = zdiff3

[alias]
	st = status
	co = checkout
	br = branch
	cm = commit
	pl = pull
	ps = push
	lg = log --oneline --graph --decorate --all

[pull]
	rebase = false

[push]
	default = simple
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential


[user]
    name = Kevin Barroso
# no pongas signingkey acá arriba, lo definimos por carpeta

[commit]
    gpgsign = true

[includeIf "gitdir:~/Github/taligent/"]
    path = ~/.gitconfig-work

[includeIf "gitdir:~/Github/personal/"]
    path = ~/.gitconfig-personal

# El repo de dotfiles usa la identidad personal para firmar commits
[includeIf "gitdir:~/.dotfiles/"]
    path = ~/.gitconfig-personal

# ~/kobo — sistema personal de agenda. Vive fuera de ~/Github porque es global,
# pero el repo es kevintali/kobo: identidad de trabajo.
[includeIf "gitdir:~/kobo/"]
    path = ~/.gitconfig-work
