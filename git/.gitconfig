[user]
	name = Kevin Barroso

[init]
	defaultBranch = dev

[core]
	editor = nvim
	autocrlf = false
  pager = cat

[alias]
	st = status
	co = checkout
	br = branch
	cm = commit
	pl = pull
	ps = push
	lg = log --oneline --graph --decorate --all

[pull]
	rebase = false

[push]
	default = simple
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential


[user]
    name = Kevin Barroso
# no pongas signingkey acá arriba, lo definimos por carpeta

[commit]
    gpgsign = true

[includeIf "gitdir:~/Github/taligent/"]
    path = ~/.gitconfig-work

[includeIf "gitdir:~/Github/personal/"]
    path = ~/.gitconfig-personal

# El repo de dotfiles usa la identidad personal para firmar commits
[includeIf "gitdir:~/.dotfiles/"]
    path = ~/.gitconfig-personal
