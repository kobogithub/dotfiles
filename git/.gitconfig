[user]
	name = Kevin Barroso
	email = kobouharriet@gmail.com

[init]
	defaultBranch = dev

[core]
	editor = nvim
	autocrlf = false
  pager = cat

[alias]
	st = status
	co = checkout
	br = branch
	cm = commit
	pl = pull
	ps = push
	lg = log --oneline --graph --decorate --all

[pull]
	rebase = false

[push]
	default = simple
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
